# CityPeak Supabase project used by Bookez.
# Use only the publishable/anon key in the mobile app. Never add service_role
# keys, database passwords, or Supabase access tokens here.
EXPO_PUBLIC_SUPABASE_URL=https://cedyrwcnyoytrnjgjxus.supabase.co
