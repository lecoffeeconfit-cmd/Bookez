{
  "expo": {
    "name": "Bookez",
    "slug": "Bookez",
    "version": "1.0.0",
    "description": "A quieter place to plan, write, and finish meaningful books.",
    "orientation": "portrait",
    "scheme": "bookez",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lecoffeeconfit.bookme",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Bookez uses your microphone to turn your spoken words into written text when you use dictation."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Bookez uses your photos for visuals, figures, and illustrations.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Bookez to use your microphone for dictation.",
          "speechRecognitionPermission": "Allow Bookez to turn your speech into writing."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8B8AE8",
          "defaultChannel": "bookez-writing"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "bookez",
          "organization": "lecoffeeconfit"
        }
      ],
      [
        "expo-file-system",
        {
          "enableFileSharing": true,
          "supportsOpeningDocumentsInPlace": true
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-mail-composer"
    ],
    "android": {
      "package": "com.lecoffeeconfit.bookme",
      "permissions": ["SCHEDULE_EXACT_ALARM"],
      "versionCode": 1,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "0f1366e7-a5a2-4e72-94a1-516e015dc07a"
      }
    }
  }
}
